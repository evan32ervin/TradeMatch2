<script id="tradematch-side-lock-script">
(function(){
const AUTH_SESSION = "tradematch_contractor_session_v3";
function findCustomerContent(){
// Prefer the original customer app if it exists in this combined prototype.
const candidates = [
document.querySelector("#customerView"),
document.querySelector(".customer-view"),
document.querySelector("#customerPage"),
document.querySelector(".customer-page")
].filter(Boolean);
return candidates[0] || null;
}
function setContractorOnly(){
const auth = document.getElementById("contractorAuthScreen");
const customer = document.getElementById("customerOnlyOverlay");
if(customer) customer.style.display="none";
if(auth && localStorage.getItem(AUTH_SESSION)==="true") auth.classList.add("auth-hidden");
// Hide any customer-facing sections while contractor is authenticated.
document.querySelectorAll("[data-customer-side]").forEach(el=>el.style.display="none");
}
window.openCustomerOnlyMode=function(){
const auth=document.getElementById("contractorAuthScreen");
const overlay=document.getElementById("customerOnlyOverlay");
const content=document.getElementById("customerOnlyContent");
if(!overlay || !content) return;
// Keep contractor session intact, but temporarily hide contractor UI.
document.querySelectorAll("body > :not(#contractorAuthScreen):not(#customerOnlyOverlay)").forEach(el=>{
if(el.id!=="customerOnlyOverlay") el.dataset.hiddenForCustomerMode = el.style.display || "";
});
const customer=findCustomerContent();
if(customer){
content.innerHTML="";
const clone=customer.cloneNode(true);
clone.style.display="block";
content.appendChild(clone);
}else{
// If the combined prototype uses different selectors, show all customer-marked elements.
const marked=[...document.querySelectorAll("[data-customer-side]")];
content.innerHTML="";
if(marked.length){
marked.forEach(el=>content.appendChild(el.cloneNode(true)));
}else{
content.innerHTML='<div style="max-width:900px;margin:70px auto;padding:24px;text-align:center;font-family:system-ui;"><h1>Customer Portal</h1><p>Customer-side content is available in the TradeMatch prototype.</p></div>';
}
}
if(auth) auth.classList.add("auth-hidden");
overlay.style.display="block";
window.scrollTo({top:0,behavior:"smooth"});
};
window.exitCustomerOnlyMode=function(){
const overlay=document.getElementById("customerOnlyOverlay");
if(overlay) overlay.style.display="none";
document.querySelectorAll("[data-hidden-for-customer-mode]").forEach(el=>{
el.style.display=el.dataset.hiddenForCustomerMode;
delete el.dataset.hiddenForCustomerMode;
});
// Return to contractor authentication rather than automatically entering the contractor side.
const auth=document.getElementById("contractorAuthScreen");
if(auth){
auth.classList.remove("auth-hidden");
if(typeof switchContractorAuth==="function") switchContractorAuth("login");
}
};
document.addEventListener("DOMContentLoaded",function(){
// In authenticated contractor mode, suppress obvious customer navigation/buttons.
if(localStorage.getItem(AUTH_SESSION)==="true") setContractorOnly();
});
})();
</script>

<script id="mandatory-contractor-signin-gate">
(function(){
const auth = document.getElementById("contractorAuthScreen");
if(!auth) return;
// The contractor prototype always opens at the sign-in screen.
// The session can still be created after a successful login.
auth.classList.remove("auth-hidden");
// Hide contractor content until login succeeds.
const contractorSelectors = [
".contractor-view","#contractorView","#contractorDashboard",
".contractor-only"
];
contractorSelectors.forEach(sel=>{
document.querySelectorAll(sel).forEach(el=>{
if(el.id !== "contractorAuthScreen"){
el.dataset.lockedContractorContent = "true";
el.style.setProperty("visibility","hidden","important");
}
});
});
// When the existing login function hides the auth screen, reveal contractor content.
const reveal = ()=>{
if(auth.classList.contains("auth-hidden")){
document.querySelectorAll('[data-locked-contractor-content="true"]').forEach(el=>{
el.style.removeProperty("visibility");
});
}
};
const observer = new MutationObserver(reveal);
observer.observe(auth,{attributes:true,attributeFilter:["class"]});
})();
</script>

