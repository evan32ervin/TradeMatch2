function makeJobIcon(job){
const colors = {Plumbing:"#2563eb", Electrical:"#f59e0b", HVAC:"#0ea5e9", Handyman:"#7c3aed", Roofing:"#dc2626", Painting:"#16a34a"};
const letter = job.trade === "Electrical" ? "E" : job.trade === "Roofing" ? "R" : job.trade === "HVAC" ? "H" : job.trade === "Painting" ? "P" : job.trade === "Handyman" ? "H" : "P";
return L.divIcon({
className:"trade-job-marker",
html:`<div style="width:32px;height:32px;border-radius:50%;background:${colors[job.trade] || "#2563eb"};border:3px solid white;box-shadow:0 2px 8px rgba(15,23,42,.28);display:grid;place-items:center;color:white;font-weight:900;font-size:11px;">${letter}</div>`,
iconSize:[32,32],
iconAnchor:[16,16],
popupAnchor:[0,-14]
});
}
function initTradeMap(){
if(typeof L === "undefined") return;
if(tradeMapInstance){
tradeMapInstance.invalidateSize();
return;
}
// Center on Louisville while keeping Middletown clearly visible.
tradeMapInstance = L.map("tradeMap", {scrollWheelZoom:true}).setView([38.2453, -85.60], 11);
L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
maxZoom:19,
attribution:'© OpenStreetMap contributors'
}).addTo(tradeMapInstance);
tradeJobs.forEach((job, index)=>{
const marker = L.marker([job.lat, job.lng], {icon:makeJobIcon(job)})
.addTo(tradeMapInstance)
.bindPopup(`<div class="leaflet-job-title">${job.title}</div><div class="leaflet-job-meta">${job.trade} · ${job.area}</div>`);
job.marker = marker;
});
// Middletown is highlighted with a small label, not an oval/blue region.
L.marker([38.2453, -85.5396], {
icon:L.divIcon({
className:"middletown-label",
html:'<div style="background:white;border:1px solid #cbd5e1;border-radius:7px;padding:4px 7px;font-weight:800;font-size:11px;box-shadow:0 2px 7px rgba(15,23,42,.12);">Middletown</div>',
